# Optional provider configuration. Runtime behavior is configured in code, per
# XAIRuntime instance; langgraph-xai itself reads none of these variables.
# Never commit real credentials.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Model-backed examples and the live evaluation harness.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# The PostgreSQL store example (examples/postgres_store.py).
XAI_POSTGRES_DSN=

# Live test targets (see docs/development/testing.md). Point them at disposable
# services; pytest skips each suite when its variables are unset.
XAI_TEST_POSTGRES_DSN=
XAI_TEST_OTEL_ENDPOINT=
XAI_TEST_LANGFUSE_HOST=
XAI_TEST_LANGFUSE_PUBLIC_KEY=
XAI_TEST_LANGFUSE_SECRET_KEY=
XAI_TEST_LLM_API_KEY=
XAI_TEST_LLM_BASE_URL=
XAI_TEST_LLM_MODEL=
