# Optional provider configuration only. Runtime behavior is configured
# programmatically per XAIRuntime instance. Never commit real credentials.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
XAI_POSTGRES_DSN=

# Live integration test targets only (see docs/development/testing.md).
# Point these at disposable local containers (e.g. via Podman); pytest skips
# each suite automatically when its variables are unset.
XAI_TEST_POSTGRES_DSN=
XAI_TEST_OTEL_ENDPOINT=
XAI_TEST_LANGFUSE_HOST=
XAI_TEST_LANGFUSE_PUBLIC_KEY=
XAI_TEST_LANGFUSE_SECRET_KEY=
